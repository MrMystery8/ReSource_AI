{
  "app": "npx ts-node --prefer-ts-exts infra/bin/app.ts",
  "watch": {
    "include": ["infra/**"],
    "exclude": [
      "README.md",
      "node_modules",
      "**/*.js",
      "**/*.d.ts"
    ]
  },
  "context": {
    "authMode": "cognito",
    "cognitoDomainPrefix": "resource-ai-auth-dev1",
    "@aws-cdk/aws-lambda:recognizeLayerVersion": true,
    "@aws-cdk/core:checkSecretUsage": true,
    "@aws-cdk/core:target-partitions": ["aws", "aws-cn"],
    "cognitoCallbackUrls": [
      "http://localhost:5173/auth/callback",
      "https://du1pydjgrqi6x.cloudfront.net/auth/callback"
    ],
    "cognitoLogoutUrls": [
      "http://localhost:5173/login",
      "https://du1pydjgrqi6x.cloudfront.net/login"
    ]
  }
}

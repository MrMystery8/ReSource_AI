{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "outDir": "dist",
    "rootDir": ".",
    "paths": {
      "@resource-ai/shared": ["../shared/src/index.ts"]
    }
  },
  "include": ["bin/**/*", "lib/**/*"],
  "references": [
    { "path": "../shared" }
  ]
}
